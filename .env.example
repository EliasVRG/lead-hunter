# ── Redis (fila) ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6391

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# A porta 5442 é a exposta pelo docker-compose (5432 costuma estar ocupada).
DATABASE_URL=postgres://lead:lead@localhost:5442/leads

# ── OpenRouter (único provedor de IA) ───────────────────────────────────────
# Crie a chave em https://openrouter.ai/keys — ela começa com "sk-or-v1-".
OPENROUTER_API_KEY=

# Cadeia de fallback, separada por vírgula, em ordem de preferência. Os dois
# primeiros suportam structured outputs (json_schema); os demais só json_object
# e servem de reserva quando a cota gratuita do primeiro acaba.
# Revalidar com: curl -s https://openrouter.ai/api/v1/models | jq '.data[] | select(.id | endswith(":free")) | .id'
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Opcionais
# OPENROUTER_MAX_ATTEMPTS_PER_MODEL=2
# OPENROUTER_TIMEOUT_MS=90000
# OPENROUTER_MAX_OUTPUT_TOKENS=2048
# AI_TEMPERATURE_TRIAGE=0.1
# AI_TEMPERATURE_PROPOSAL=0.4

# ── Filas ───────────────────────────────────────────────────────────────────
# Triagem e proposta ficam baixas de propósito: o tier gratuito é rate-limited.
# DISCOVERY_CONCURRENCY=1
# TRIAGE_CONCURRENCY=2
# PROPOSAL_CONCURRENCY=1

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# ── Descoberta automática ───────────────────────────────────────────────────
# Sem isto, a descoberta só roda via POST /discovery/runs — e as vagas chegam
# com 130-230 propostas concorrentes, tarde demais para converter.
DISCOVERY_SCHEDULE_ENABLED=true
DISCOVERY_SCHEDULE_EVERY_MS=600000       # 10 min
DISCOVERY_SCHEDULE_MAX_AGE_HOURS=3       # ignora vagas mais velhas que isso
DISCOVERY_SCHEDULE_MAX_PAGES=2
DISCOVERY_SCHEDULE_MAX_LISTINGS=20
# DISCOVERY_SCHEDULE_QUERY=              # vazio = todas as vagas
# DISCOVERY_SCHEDULE_CATEGORY=

# ── Notificação de vaga compatível (tier APPLY) ─────────────────────────────
# desktop = notify-send (Linux, exige sessão gráfica) | webhook | none
NOTIFIER=desktop
# NOTIFIER_WEBHOOK_URL=https://hooks.slack.com/...

# ── Filtro de vaga morta (antes da IA) ──────────────────────────────────────
# Vaga com muita concorrência ou prazo vencido é descartada sem gastar IA.
SCREENING_DROP_EXPIRED=true
SCREENING_MAX_PROPOSALS=40     # 0 desliga. Em dados reais, corta ~10% das vagas
SCREENING_MAX_AGE_HOURS=0      # 0 desliga (a descoberta já filtra por idade)
